<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/sidebar_settings_size"
        android:layout_height="@dimen/sidebar_settings_size"
        android:layout_margin="12dp"
        android:background="?attr/blblFocusBgRound"
        android:focusable="true"
        android:padding="@dimen/sidebar_settings_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:tint="?attr/blblOnPageBackdrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_search"
        android:layout_width="@dimen/sidebar_settings_size"
        android:layout_height="@dimen/sidebar_settings_size"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/blblFocusBgRound"
        android:contentDescription="搜索设置"
        android:focusable="true"
        android:padding="@dimen/sidebar_settings_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_search"
        app:tint="?attr/blblOnPageBackdrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="设置"
        android:textColor="?attr/blblOnPageBackdrop"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/btn_search"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <LinearLayout
        android:id="@+id/ll_settings_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_settings_search"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?attr/blblFocusBgRound"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hint="@string/settings_search_hint"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textColorHint="?attr/blblOnPageBackdropSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_settings_search_clear"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="?attr/blblFocusBgRound"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/settings_search_clear"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_settings_search_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_left"
        android:layout_width="252dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_settings_search" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:paddingStart="@dimen/settings_content_padding_h"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/settings_content_padding_h"
        android:paddingBottom="@dimen/settings_content_padding_v"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/recycler_left"
        app:layout_constraintTop_toBottomOf="@id/ll_settings_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
